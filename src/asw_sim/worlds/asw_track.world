<?xml version="1.0"?>
<sdf version="1.6">
  <world name="asw_track">
    <!-- 좌표계: 트랙 왼쪽 아래 모서리 = (0,0), 트랙은 (0..8.5, 0..8.5) -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>4.25 4.25 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.3 0.2 -1</direction>
      <cast_shadows>false</cast_shadows>
    </light>
    <!-- 바닥: model://ground_plane 을 쓰면 Gazebo가 온라인 모델 DB를 조회하다 멈출 수 있어 직접 정의 -->
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>
    <include>
      <uri>model://asw_track</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>
    <gui>
      <camera name="user_camera">
        <pose>4.25 -3.5 9.5 0 0.95 1.5708</pose>
      </camera>
    </gui>
  </world>
</sdf>
